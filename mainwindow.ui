        <property name="styleSheet">
         <string notr="true">/* ========= PANE TRANSPARENT (fond du QTabWidget) ========= */
QTabWidget#btn_home::pane {
    border: none;
    background: transparent;   /* on voit ton background global */
}

/* Position de la barre d'onglets */
QTabWidget#btn_home::tab-bar {
    alignment: left;
}

/* ========= ONGLET NORMAL (non sélectionné) ========= */
QTabWidget#btn_home QTabBar::tab {
    background: transparent;
    color: #ffffff;
    padding: 6px 22px;
    border: none;
    margin-right: 8px;
    margin-bottom: 8px;        /* 🔥 détache l’onglet du pane → on voit bien l’arrondi */
    font-weight: 600;
    border-radius: 50px;       /* forme capsule, pas carré */
}

/* ========= ONGLET SÉLECTIONNÉ (capsule violette) ========= */
QTabWidget#btn_home QTabBar::tab:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #c72cff,
        stop:1 #4a7dff
    );
    color: #ffffff;
    border-radius: 50px;
}

/* ========= HOVER (survol léger) ========= */
QTabWidget#btn_home QTabBar::tab:hover {
    background: rgba(255, 255, 255, 0.12);
    border-radius: 18px;
}
</string>
