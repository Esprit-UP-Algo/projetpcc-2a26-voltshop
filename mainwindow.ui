        <property name="styleSheet">
         <string notr="true">#widget_8 {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,

        /* Bleu très clair en entrée */
        stop:0 rgba(90, 150, 255, 70),

        /* Bleu encore plus clair au centre */
        stop:0.5 rgba(140, 190, 255, 60),

        /* Bleu léger et doux en sortie */
        stop:1 rgba(100, 160, 255, 70)
    );

    border-radius: 26px;

    /* contour très discret */
    border: 1px solid rgba(255, 255, 255, 50);

    /* Reflet intérieur très soft (effet verre) */
    box-shadow:
        inset 0 0 35px rgba(255, 255, 255, 30),
        0 0 20px rgba(100, 160, 255, 25);
}
</string>
