     <property name="styleSheet">
      <string notr="true">QPushButton {
    background-color: #003271;   /* base color */
    color: white;
    border-radius: 8px;
    padding: 8px 14px;
    font-weight: bold;
    qproperty-icon: url(C:/Users/lastg/Desktop/credit-card.png);
    qproperty-iconSize: 100px 100px;
    transition: all 0.3s ease;   /* smooth hover effect */
}

/* Hover effect */
QPushButton:hover {
    background-color: #004a9f;   /* lighter blue */
}

/* Pressed effect */
QPushButton:pressed {
    background-color: #00204d;   /* darker blue */
    padding-left: 16px;          /* slight &quot;press&quot; animation */
    padding-top: 9px;
}

/* Disabled state */
QPushButton:disabled {
    background-color: #7f8c8d;
    color: #dfe6e9;
}
