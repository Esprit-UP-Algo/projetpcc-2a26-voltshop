    background: rgba(255,255,255,0);
}

QTabBar::tab:hover {
    background: rgba(255,255,255,0.05);
}

/* Rendre la PAGE interne transparente */
QTabWidget &gt; QWidget {
    background: transparent;
    border: none;
}
