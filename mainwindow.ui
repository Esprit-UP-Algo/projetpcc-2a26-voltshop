    <property name="styleSheet">
     <string notr="true">/* ===========================
   SIDEBAR (groupBox_2)
   =========================== */

QGroupBox#groupBox_2 {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(34, 0, 68, 0.95),
        stop:1 rgba(13, 0, 26, 0.98)
    );
    border: none;
    border-radius: 28px;
    color: white;
    padding-top: 20px;
}

/* Tous les boutons dans la sidebar */
QGroupBox#groupBox_2 QPushButton {
    background: transparent;
    color: white;
    border: none;
    text-align: left;
    padding: 10px 26px;
    font-size: 15px;
    font-weight: 500;
}

/* Effet hover léger */
QGroupBox#groupBox_2 QPushButton:hover {
    background: rgba(255, 255, 255, 0.10);
    border-radius: 20px;
}

/* === BOUTON SELECTIONNÉ (capsule violette) === */
QGroupBox#groupBox_2 QPushButton[selected=&quot;true&quot;] {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(180, 0, 255, 0.90),
        stop:1 rgba(0, 180, 255, 0.90)
    );
    border-radius: 22px;
    color: white;
    font-weight: 700;
    padding: 10px 28px;
}

/* Tu peux personnaliser LOG OUT si tu veux */
QGroupBox#groupBox_2 QPushButton#btn_Logout {
    background: rgba(0, 120, 255, 0.9);
    border-radius: 8px;
    padding: 8px 26px;
}

QGroupBox#groupBox_2 QPushButton#btn_Logout:hover {
    background: rgba(50, 150, 255, 1.0);
}
</string>
