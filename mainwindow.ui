          <widget class="QTableWidget" name="tableWidget_4">
           <property name="geometry">
            <rect>
             <x>30</x>
             <y>90</y>
             <width>671</width>
             <height>271</height>
            </rect>
           </property>
           <property name="styleSheet">
            <string notr="true">QTableWidget {
    background: qlineargradient(
        x1:0, y1:0, x2:0, y2:1,
        stop:0 rgba(26, 26, 46, 0.95),
        stop:1 rgba(20, 20, 35, 0.98)
    );
    color: white;
    gridline-color: rgba(100, 200, 255, 0.2);
    border: 2px solid qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00eaff,
        stop:1 #6a7cff
    );
    border-radius: 8px;
    selection-background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 234, 255, 0.3),
        stop:1 rgba(106, 124, 255, 0.3)
    );
    selection-color: white;
    font-family: 'Segoe UI', Arial, sans-serif;
    font-size: 11pt;
}

QTableWidget::item {
    padding: 8px;
    border: none;
}

QTableWidget::item:hover {
    background: rgba(0, 234, 255, 0.15);
}

QTableWidget::item:selected {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 rgba(0, 234, 255, 0.4),
        stop:1 rgba(106, 124, 255, 0.4)
    );
    color: white;
}

QHeaderView::section {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #4472C4,
        stop:1 #6a7cff
    );
    color: white;
    padding: 8px;
    border: none;
    font-weight: bold;
    font-size: 11pt;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
}

QHeaderView::section:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #5588dd,
        stop:1 #7a8cff
    );
}

QScrollBar:vertical {
    background: rgba(26, 26, 46, 0.5);
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00eaff,
        stop:1 #6a7cff
    );
    border-radius: 6px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00ffff,
        stop:1 #7a8cff
    );
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: rgba(26, 26, 46, 0.5);
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00eaff,
        stop:1 #6a7cff
    );
    border-radius: 6px;
    min-width: 20px;
}

QScrollBar::handle:horizontal:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00ffff,
        stop:1 #7a8cff
    );
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

QTableCornerButton::section {
    background: #4472C4;
    border: none;
}
</string>
