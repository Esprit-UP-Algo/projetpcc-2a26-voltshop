         <property name="styleSheet">
          <string notr="true">QDateEdit {
    color: white;
    background: transparent;
    padding: 6px 14px;
    border-radius: 18px;
    border: 2px solid qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00eaff,
        stop:1 #6a7cff
    );
}

QDateEdit:focus {
    border: 2px solid #00eaff;
    box-shadow: 0 0 12px #00eaff;
}

QDateEdit::drop-down {
    border: none;
    background: transparent;
    width: 24px;
}

QDateEdit::down-arrow {
    image: url(:/images/ressource/icons8-calendar-50.png);
    width: 20px;
    height: 20px;
}
</string>
