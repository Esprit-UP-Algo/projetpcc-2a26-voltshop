       <widget class="QPushButton" name="c_confirm">
        <property name="geometry">
         <rect>
          <x>40</x>
          <y>590</y>
          <width>161</width>
          <height>51</height>
         </rect>
        </property>
        <property name="styleSheet">
         <string notr="true">QPushButton {
    color: white;
    font-weight: bold;

    /* forme capsule parfaite */
    padding: 10px 28px;
    border-radius: 22px;

    /* dégradé violet → bleu (identique à la maquette) */
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #d147ff,     /* violet clair */
        stop:1 #4a7dff      /* bleu clair */
    );

    border: none;

    /* Glow léger autour du bouton (comme la maquette) */
    box-shadow: 0px 0px 12px rgba(120, 140, 255, 0.45);
}

/* Effet hover : un peu plus lumineux */
QPushButton:hover {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #e66bff,
        stop:1 #6a92ff
    );
}

/* Effet clic : bouton écrasé légèrement */
QPushButton:pressed {
    transform: scale(0.96);
    box-shadow: 0px 0px 6px rgba(120, 140, 255, 0.3);
}
</string>
