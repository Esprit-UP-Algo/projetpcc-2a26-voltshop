           <property name="styleSheet">
            <string notr="true">QLineEdit {
    color: white;
    background: transparent;
    padding: 6px 14px;
    border-radius: 18px;

    /* Bordure lumineuse bleu/cyan comme la photo */
    border: 2px solid qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 #00eaff,
        stop:1 #6a7cff
    );
}

/* Effet glow au focus */
QLineEdit:focus {
    border: 2px solid #00eaff;
    box-shadow: 0 0 12px #00eaff;
}
