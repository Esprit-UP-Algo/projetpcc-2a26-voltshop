    padding: 6px;
}

/* Tabs container */
QTabBar::tab {
    background: #003271;
    color: white;
    padding: 8px 16px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    margin-right: 2px;
    font-weight: bold;
}

/* Selected tab */
QTabBar::tab:selected {
    background: #ADD8E6;
    color: white;
}

/* Hover effect */
QTabBar::tab:hover {
    background: #004599;
    color: white;
}</string>
