    background-color: white;
    border: 2px solid #90caf9;
    border-radius: 8px;
    padding: 12px 16px;
    font-size: 14px;
    color: #000000;
    font-family: &quot;Segoe UI&quot;, Arial;
}

QLineEdit:focus {
